{
  "name": "@brightstart/training-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10 <11"
  },
  "scripts": {
    "build": "npm run build:styles && tsc --project tsconfig.build.json",
    "build:styles": "sass --no-source-map --pkg-importer=node src/styles/application.scss public/application.css",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "dev": "npm run build:styles && tsx watch src/server.ts",
    "lint": "eslint .",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc --project tsconfig.json"
  },
  "dependencies": {
    "express": "5.2.1",
    "express-session": "1.19.0",
    "govuk-frontend": "6.5.1",
    "nunjucks": "3.2.4"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/express-session": "1.19.0",
    "@types/node": "22.20.4",
    "@types/nunjucks": "3.2.6",
    "@types/supertest": "7.2.1",
    "eslint": "10.11.0",
    "sass": "1.105.0",
    "supertest": "7.3.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.2"
  }
}
