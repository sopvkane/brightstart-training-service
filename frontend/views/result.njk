{% extends "layout.njk" %}

{% block content %}
  <h1 class="govuk-heading-xl">Training journey completed</h1>
  <p class="govuk-body govuk-!-font-size-27"><strong>Synthetic result: Accepted</strong></p>
  <p class="govuk-body">Submission reference: {{ submission.submissionId }}</p>
  <p class="govuk-body">Address: {{ address }}</p>
  <p class="govuk-body">Identity document: {{ documentName }}</p>
  <img class="app-uploaded-image govuk-!-margin-bottom-6" src="/document-image" alt="Uploaded {{ documentName | lower }} image">
  <p class="govuk-body">This is a fictional training result. No real identity check or government decision has occurred.</p>
{% endblock %}
