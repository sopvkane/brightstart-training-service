{% from "govuk/components/generic-header/macro.njk" import govukGenericHeader %}
<!doctype html>
<html class="govuk-template" lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="#4c2c92">
    <title>{{ pageTitle }}</title>
    <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
    <link rel="stylesheet" href="/assets/application.css">
  </head>
  <body class="govuk-template__body">
    <script>
      document.body.className +=
        ' js-enabled' + ('noModule' in HTMLScriptElement.prototype ? ' govuk-frontend-supported' : '')
    </script>
    <a class="govuk-skip-link" href="#main-content">Skip to main content</a>

    {{ govukGenericHeader({
      logoText: "BrightStart Training Service",
      url: "/",
      classes: "app-generic-header"
    }) }}

    <main class="govuk-main-wrapper govuk-width-container" id="main-content" tabindex="-1">
      {% block content %}{% endblock %}
    </main>

    <script type="module">
      import { initAll } from '/assets/govuk/govuk-frontend.min.js'

      initAll()
    </script>
  </body>
</html>
